#!/usr/bin/env pascal
program PascalShowcase;

const
  MIN_VAL = 1;
  MAX_VAL = 10000;

type
  PrimalityResult = (Prime, NotPrime);

var
  Number: Integer;

function IsPrime(n: Integer): PrimalityResult;
var
  i: Integer;
  isComposite: Boolean;
begin
  if n < 2 then IsPrime := NotPrime
  else
    begin
      if n = 2 then IsPrime := Prime
      else if (n mod 2 = 0) then IsPrime := NotPrime
      else
        begin
          isComposite := False;
          i := 3;
          while (i * i <= n) and not isComposite do
            begin
              if n mod i = 0 then isComposite := True;
              i := i + 2;
            end;

          if isComposite then IsPrime := NotPrime
          else IsPrime := Prime;
        end;
    end;
end;

function IsPalindrome(n: Integer): Boolean;
var
  original, temp, reverseNum: Integer;
begin
  if n < 0 then IsPalindrome := False
  else
    begin
      original := n;
      temp := n;
      reverseNum := 0;

      while temp > 0 do
        begin
          reverseNum := reverseNum * 10 + (temp mod 10);
          temp := temp div 10;
        end;

      IsPalindrome := (original = reverseNum);
    end;
end;

function IsPerfect(n: Integer): Boolean;
var
  i, divisorSum: Integer;
begin
  if n < 1 then IsPerfect := False
  else
    begin
      divisorSum := 0;
      for i := 1 to n div 2 do
        if n mod i = 0 then divisorSum := divisorSum + i;

      IsPerfect := (divisorSum = n);
    end;
end;

procedure GetValidInput(var n: Integer);
var
  temp: Integer;
begin
  repeat
    Write('Enter a positive integer (', MIN_VAL, '-', MAX_VAL, '): ');
    ReadLn(temp);

    if (temp < MIN_VAL) or (temp > MAX_VAL) then
      WriteLn('Invalid input. Please enter a number within the specified range.');
  until (temp >= MIN_VAL) and (temp <= MAX_VAL);

  n := temp;
end;

procedure DisplayResults(n: Integer);
begin
  WriteLn;
  WriteLn('╔══════════════════════════════╗');
  WriteLn('║  Number Analysis Results     ║');
  WriteLn('╠══════════════════════════════╣');

  WriteLn('║  Number: ', n:6, '              ║');

  if IsPrime(n) = Prime then
    WriteLn('║  Prime:        ✓ Yes         ║')
  else
    WriteLn('║  Prime:        ✗ No          ║');

  if IsPalindrome(n) then
    WriteLn('║  Palindrome:   ✓ Yes         ║')
  else
    WriteLn('║  Palindrome:   ✗ No          ║');

  if IsPerfect(n) then
    WriteLn('║  Perfect:      ✓ Yes         ║')
  else
    WriteLn('║  Perfect:      ✗ No          ║');

  WriteLn('╚══════════════════════════════╝');
end;

begin
  WriteLn('╔══════════════════════════════╗');
  WriteLn('║   Pascal Showcase Program    ║');
  WriteLn('╚══════════════════════════════╝');

  GetValidInput(Number);
  DisplayResults(Number);
end.
