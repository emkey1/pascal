program LargeStaticArray;
{ 3,000,000 integers is 48 MB of Values, under the 256 MB array storage cap;
  a separate 2M-element cap used to reject it. }
var
  a: array[1..3000000] of integer;
  i: integer;
  sum: int64;
begin
  for i := 1 to 3000000 do
    if i mod 1000000 = 0 then a[i] := i div 1000000;
  sum := 0;
  for i := 1 to 3000000 do
    sum := sum + a[i];
  writeln('last=', a[3000000], ' sum=', sum);
end.
