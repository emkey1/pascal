program NestedStaticArrayConstIndexTest;
{ Constant indexes into an array of arrays. The compiler folded b[1][2]
  into one flat offset into b, so `b[1][2] := 5` replaced all of b[2]. }
type Row = array[1..3] of integer;
var b: array[1..3] of array[1..3] of integer;
    f: array[1..2, 1..3] of integer;
    r: array[1..2] of Row;
    i, j: integer;
begin
  for i := 1 to 3 do for j := 1 to 3 do b[i][j] := 10 * i + j;
  b[1][2] := 5;
  b[3, 3] := 99;
  for i := 1 to 3 do begin for j := 1 to 3 do write(b[i][j], ' '); writeln; end;
  writeln(b[1][2], ' ', b[1, 2], ' ', b[3][3]);
  for i := 1 to 2 do for j := 1 to 3 do f[i, j] := 0;
  f[2][3] := 7; f[1, 2] := 4;
  writeln(f[1][2], ' ', f[2, 3], ' ', f[1][1]);
  r[2][1] := 8; r[1][3] := 6;
  writeln(r[2][1], ' ', r[1][3], ' ', r[2, 1]);
end.
