program LifetimeArrayAssignVarAlias;
{ Whole static-array assignment keeps the array's storage: a VAR parameter
  aliasing an element (or a field of an element) stays valid across it. }
type
  TRec = record x, y: integer; end;
  TArr = array[1..3] of TRec;
var a, b: array[1..4] of integer;
    c, d: array[1..3] of integer;
    i: integer;

procedure P(var x: integer; y: integer);
begin
  x := y;
end;

function F: integer;
begin
  a := b;
  F := 42;
end;

procedure Q(var x: integer);
begin
  c := d;
  x := 5;
end;

procedure Outer;
var ra, rb: TArr; r: TRec;
  procedure Touch(var v: integer);
  begin
    ra := rb;
    v := 8;
  end;
  procedure TouchR(var v: integer);
  begin
    r := rb[2];
    v := 4;
  end;
begin
  rb[1].x := 100; rb[2].x := 200; rb[2].y := 201;
  ra[1].x := 1;
  Touch(ra[1].x);
  writeln('ra[1].x=', ra[1].x, ' ra[2].x=', ra[2].x, ' rb[1].x=', rb[1].x);
  TouchR(r.y);
  writeln('r.x=', r.x, ' r.y=', r.y, ' rb[2].y=', rb[2].y);
end;

begin
  a[1] := 5;
  P(a[1], F);
  writeln('a[1]=', a[1]);
  i := 1;
  c[1] := 1; d[1] := 7;
  Q(c[i]);
  writeln(c[1], ' ', d[1]);
  Outer;
end.
