program TaskCancelAfterAwaitThenSpawn;
{ Cancelling a task that has already been awaited used to retire the idle
  worker that ran it while the pool still counted it as available, so the
  next spawn waited forever for a worker that no longer existed. }
var
  t1, t2: task;
  r1, r2, i, total: integer;

function Quick(n: integer): integer;
begin
  Quick := n;
end;

begin
  total := 0;
  for i := 1 to 200 do
  begin
    t1 := TaskSpawn('Quick', 1);
    r1 := TaskAwait(t1);
    TaskCancel(t1);
    t2 := TaskSpawn('Quick', 2);
    r2 := TaskAwait(t2);
    total := total + r1 + r2;
  end;
  writeln('total = ', total);
end.
