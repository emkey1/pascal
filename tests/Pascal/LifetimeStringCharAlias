program LifetimeStringCharAlias;
{ A VAR char parameter aliasing s[i] keeps working: swaps through two
  aliases of the same string, a write while the string is also changed
  through s[j], and a late write after s was reassigned (it lands in the
  old string, which the alias keeps alive, instead of freed memory). }
var s, t: string; a: array[1..3] of char;

procedure SwapChars(var x, y: char);
var tmp: char;
begin
  tmp := x; x := y; y := tmp;
end;

procedure SetBoth(var x: char);
begin
  s[2] := 'Q';
  x := 'Z';
end;

procedure P(var c: char; y: char);
begin
  c := y;
end;

function F: char;
begin
  s := 'other';
  F := 'x';
end;

procedure Longer(var c: char);
begin
  s := 'a much longer replacement string that forces a new buffer allocation';
  c := 'X';
end;

begin
  s := 'abc';
  SwapChars(s[1], s[3]);
  writeln(s);
  t := s;
  SwapChars(s[1], s[2]);
  writeln(s, ' ', t);
  SetBoth(s[1]);
  writeln(s, ' ', t);
  a[1] := 'x'; a[2] := 'y'; a[3] := 'z';
  SwapChars(a[1], a[3]);
  writeln(a[1], a[2], a[3]);
  s := 'hello';
  P(s[1], F);
  writeln(s);
  s := 'hello' + 'world';
  Longer(s[1]);
  writeln(s);
end.
