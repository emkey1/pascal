program LifetimeMultiDimRowAssign;
{ Assigning a whole row of a multi-dimensional array writes the row's
  elements into the array. }
type
  TMatrix = array of array of Integer;
  TLinear = array of Integer;
  TRow = array[1..3] of integer;
var m: TMatrix; row: TLinear; i, j: Integer;
    s: array[1..2] of TRow; srow: TRow;
begin
  SetLength(m, 3, 4);
  SetLength(row, 4);
  for i := 0 to 3 do row[i] := i + 100;
  m[1] := row;
  for i := 0 to 2 do
  begin
    for j := 0 to 3 do write(m[i][j], ' ');
    writeln;
  end;
  for i := 1 to 3 do srow[i] := i * 10;
  s[2] := srow;
  for i := 1 to 2 do
  begin
    for j := 1 to 3 do write(s[i][j], ' ');
    writeln;
  end;
end.
